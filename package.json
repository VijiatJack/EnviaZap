{
  "name": "enviazap",
  "version": "1.0.0",
  "description": "EnviaZap - Bot WhatsApp para envio em massa",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:visible": "set HEADLESS=false && node index.js",
    "dev": "node --watch index.js",
    "debug": "node --inspect index.js",
    "kill-chrome": "taskkill /F /IM chrome.exe /T 2>nul || echo Nenhum processo Chrome encontrado",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"],
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/modules/*.js",
      "src/utils/formatter.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      }
    },
    "coverageReporters": ["text", "lcov"]
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
